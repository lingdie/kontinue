FROM rust:1.85-alpine AS builder

RUN apk add --no-cache musl-dev gcc

WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release --workspace

FROM alpine:3.20 AS artifacts
COPY --from=builder /workspace/target/release/ktd /out/ktd
COPY --from=builder /workspace/target/release/kontinue-runsc /out/kontinue-runsc
COPY --from=builder /workspace/target/release/kontinue-arena-helper /out/kontinue-arena-helper
COPY --from=builder /workspace/target/release/kontinue-carrier /out/kontinue-carrier
